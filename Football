<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>11th VS 9th - Epic Football Clash</title>
    <style>
        :root {
            --primary-blue: #00d4ff;
            --primary-red: #ff0055;
            --dark-bg: #0a0e27;
            --darker-bg: #05070f;
            --neon-blue: #00f0ff;
            --neon-red: #ff0066;
            --subtle-glow: #1a1f3a;
            --text-primary: #ffffff;
            --text-secondary: #b0b5c1;
            --border-color: #1a1f3a;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--dark-bg);
            color: var(--text-primary);
            overflow-x: hidden;
            position: relative;
        }

        /* Animated Background */
        .animated-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 20% 50%, rgba(0, 212, 255, 0.1) 0%, transparent 50%),
                        radial-gradient(circle at 80% 80%, rgba(255, 0, 85, 0.1) 0%, transparent 50%),
                        linear-gradient(135deg, var(--darker-bg) 0%, var(--dark-bg) 100%);
            z-index: -1;
            animation: backgroundShift 15s ease-in-out infinite;
        }

        @keyframes backgroundShift {
            0%, 100% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
        }

        @keyframes rippleEffect {
            from {
                transform: scale(0);
                opacity: 1;
            }
            to {
                transform: scale(4);
                opacity: 0;
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Header */
        .header {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(10, 14, 39, 0.95);
            backdrop-filter: blur(10px);
            border-bottom: 2px solid rgba(0, 212, 255, 0.2);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 0 30px rgba(0, 212, 255, 0.1);
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 900;
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            letter-spacing: 2px;
        }

        .nav-links {
            display: flex;
            gap: 2rem;
        }

        .nav-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            position: relative;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: -5px;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--primary-blue), var(--primary-red));
            transition: width 0.3s ease;
        }

        .nav-links a:hover {
            color: var(--primary-blue);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        /* Container */
        .container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 2rem;
        }

        /* Section Title */
        .section-title {
            font-size: 2.5rem;
            text-align: center;
            margin-bottom: 3rem;
            background: linear-gradient(135deg, var(--primary-blue), var(--primary-red));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-weight: 900;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        /* Hero Section */
        .hero {
            position: relative;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            margin-top: -5rem;
            padding-top: 5rem;
        }

        .stadium-bg {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 800"><defs><pattern id="grid" width="80" height="80" patternUnits="userSpaceOnUse"><path d="M 80 0 L 0 0 0 80" fill="none" stroke="rgba(0,212,255,0.1)" stroke-width="1"/></pattern></defs><rect width="1200" height="800" fill="rgba(10,14,39,0.5)"/><rect width="1200" height="800" fill="url(%23grid)"/><circle cx="600" cy="400" r="300" fill="none" stroke="rgba(0,212,255,0.2)" stroke-width="2"/><line x1="600" y1="100" x2="600" y2="700" stroke="rgba(0,212,255,0.1)" stroke-width="2"/><line x1="300" y1="400" x2="900" y2="400" stroke="rgba(0,212,255,0.1)" stroke-width="2"/></svg>');
            background-size: cover;
            background-position: center;
            animation: stadiumFlicker 0.15s infinite;
            filter: saturate(1.2) brightness(1.1);
        }

        @keyframes stadiumFlicker {
            0%, 100% { filter: saturate(1.2) brightness(1.1); }
            50% { filter: saturate(1.1) brightness(1.05); }
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 50% 50%, rgba(0, 212, 255, 0.15) 0%, transparent 40%),
                        radial-gradient(circle at 50% 50%, transparent 60%, rgba(10, 14, 39, 0.8) 100%);
        }

        .hero-content {
            position: relative;
            z-index: 10;
            text-align: center;
        }

        .match-title h1 {
            font-size: 4.5rem;
            font-weight: 900;
            margin-bottom: 1rem;
            letter-spacing: 3px;
            animation: titleGlow 2s ease-in-out infinite;
        }

        @keyframes titleGlow {
            0%, 100% {
                text-shadow: 0 0 20px rgba(0, 212, 255, 0.8),
                             0 0 40px rgba(0, 212, 255, 0.4);
            }
            50% {
                text-shadow: 0 0 30px rgba(0, 212, 255, 1),
                             0 0 60px rgba(0, 212, 255, 0.6);
            }
        }

        .glow-text-blue {
            background: linear-gradient(135deg, var(--neon-blue), var(--primary-blue));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .subtitle {
            font-size: 1.3rem;
            color: var(--text-secondary);
            font-weight: 300;
            letter-spacing: 2px;
        }

        /* Match Section */
        .match-section {
            padding: 5rem 0;
            position: relative;
            z-index: 5;
        }

        /* Countdown */
        .countdown-container {
            text-align: center;
            margin-bottom: 4rem;
        }

        .countdown {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
            max-width: 800px;
            margin-left: auto;
            margin-right: auto;
        }

        .countdown-item {
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.1), rgba(255, 0, 85, 0.05));
            border: 2px solid rgba(0, 212, 255, 0.3);
            border-radius: 15px;
            padding: 1.5rem;
            transition: all 0.3s ease;
            cursor: default;
        }

        .countdown-item:hover {
            border-color: var(--primary-blue);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.4),
                        inset 0 0 20px rgba(0, 212, 255, 0.1);
            transform: translateY(-5px);
        }

        .countdown-value {
            font-size: 2.5rem;
            font-weight: 900;
            color: var(--primary-blue);
            text-shadow: 0 0 10px rgba(0, 212, 255, 0.8);
            margin-bottom: 0.5rem;
            font-variant-numeric: tabular-nums;
        }

        .countdown-label {
            font-size: 0.8rem;
            color: var(--text-secondary);
            letter-spacing: 1px;
        }

        /* Live Score Container */
        .live-score-container {
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.08), rgba(255, 0, 85, 0.08));
            border: 2px solid rgba(0, 212, 255, 0.3);
            border-radius: 20px;
            padding: 3rem;
            margin-bottom: 4rem;
            box-shadow: 0 0 50px rgba(0, 212, 255, 0.15),
                        inset 0 0 30px rgba(0, 212, 255, 0.05);
            position: relative;
            overflow: hidden;
        }

        .live-score-container::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(0, 212, 255, 0.1) 0%, transparent 70%);
            animation: glow 8s ease-in-out infinite;
            pointer-events: none;
        }

        @keyframes glow {
            0%, 100% {
                transform: translate(0, 0);
            }
            50% {
                transform: translate(50px, 50px);
            }
        }

        .live-indicator {
            text-align: center;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.8rem;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .live-dot {
            width: 12px;
            height: 12px;
            background-color: var(--primary-red);
            border-radius: 50%;
            animation: pulse 1.5s ease-in-out infinite;
            box-shadow: 0 0 10px var(--primary-red);
        }

        @keyframes pulse {
            0%, 100% {
                transform: scale(1);
                opacity: 1;
            }
            50% {
                transform: scale(1.3);
                opacity: 0.7;
            }
        }

        /* Teams Wrapper */
        .teams-wrapper {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 2rem;
            align-items: center;
            margin-bottom: 3rem;
        }

        .team {
            text-align: center;
            padding: 2rem;
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.05), rgba(255, 0, 85, 0.05));
            border: 2px solid rgba(0, 212, 255, 0.2);
            border-radius: 15px;
            transition: all 0.3s ease;
        }

        .team:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 30px rgba(0, 212, 255, 0.2);
        }

        .team-left {
            border-color: rgba(0, 212, 255, 0.4);
        }

        .team-left:hover {
            box-shadow: 0 0 30px rgba(0, 212, 255, 0.3);
        }

        .team-right {
            border-color: rgba(255, 0, 85, 0.4);
        }

        .team-right:hover {
            box-shadow: 0 0 30px rgba(255, 0, 85, 0.3);
        }

        .team-badge {
            display: inline-block;
            width: 80px;
            height: 80px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            font-weight: 900;
            margin: 0 auto 1rem;
            border: 3px solid;
        }

        .team-badge.blue {
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.3), rgba(0, 212, 255, 0.1));
            border-color: var(--primary-blue);
            color: var(--primary-blue);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.5);
        }

        .team-badge.red {
            background: linear-gradient(135deg, rgba(255, 0, 85, 0.3), rgba(255, 0, 85, 0.1));
            border-color: var(--primary-red);
            color: var(--primary-red);
            box-shadow: 0 0 20px rgba(255, 0, 85, 0.5);
        }

        .team-name {
            font-size: 2rem;
            font-weight: 900;
            letter-spacing: 2px;
            margin-bottom: 0.5rem;
        }

        .team-info {
            color: var(--text-secondary);
            font-size: 0.9rem;
            margin-bottom: 1.5rem;
            letter-spacing: 1px;
        }

        .team-stats {
            display: flex;
            justify-content: space-around;
            gap: 1rem;
            margin-top: 1.5rem;
        }

        .stat {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .stat-value {
            font-size: 1.5rem;
            font-weight: 900;
        }

        .stat-label {
            font-size: 0.8rem;
            color: var(--text-secondary);
            letter-spacing: 1px;
        }

        .blue-glow {
            color: var(--primary-blue);
            text-shadow: 0 0 10px rgba(0, 212, 255, 0.8);
        }

        .red-glow {
            color: var(--primary-red);
            text-shadow: 0 0 10px rgba(255, 0, 85, 0.8);
        }

        /* Score Display */
        .score-display {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 0 2rem;
        }

        .score-board {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 2rem;
            margin-bottom: 1rem;
        }

        .score-number {
            font-size: 4.5rem;
            font-weight: 900;
            min-width: 100px;
            text-align: center;
        }

        .score-number.blue-team {
            color: var(--primary-blue);
            text-shadow: 0 0 30px rgba(0, 212, 255, 0.8);
        }

        .score-number.red-team {
            color: var(--primary-red);
            text-shadow: 0 0 30px rgba(255, 0, 85, 0.8);
        }

        .score-vs {
            font-size: 2rem;
            color: var(--text-secondary);
            opacity: 0.5;
        }

        .match-time {
            font-size: 1.2rem;
            color: var(--text-secondary);
            font-weight: 600;
            letter-spacing: 1px;
        }

        /* Voting Section */
        .voting-section {
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.1), rgba(255, 0, 85, 0.1));
            border: 2px solid rgba(0, 212, 255, 0.3);
            border-radius: 15px;
            padding: 2.5rem;
            margin-bottom: 3rem;
        }

        .voting-title {
            text-align: center;
            font-size: 1.5rem;
            margin-bottom: 2rem;
            color: var(--primary-blue);
        }

        .voting-buttons {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .vote-btn {
            position: relative;
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.1), rgba(0, 212, 255, 0.05));
            border: 2px solid rgba(0, 212, 255, 0.3);
            border-radius: 10px;
            padding: 1.5rem;
            cursor: pointer;
            overflow: hidden;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            gap: 0.8rem;
        }

        .vote-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: rgba(0, 212, 255, 0.1);
            transition: left 0.3s ease;
            z-index: -1;
        }

        .vote-btn:hover::before {
            left: 0;
        }

        .vote-btn.vote-11th {
            border-color: var(--primary-blue);
            color: var(--primary-blue);
        }

        .vote-btn.vote-11th:hover {
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.4),
                        inset 0 0 20px rgba(0, 212, 255, 0.1);
            transform: translateY(-5px);
        }

        .vote-btn.vote-9th {
            border-color: var(--primary-red);
            color: var(--primary-red);
        }

        .vote-btn.vote-9th:hover {
            box-shadow: 0 0 20px rgba(255, 0, 85, 0.4),
                        inset 0 0 20px rgba(255, 0, 85, 0.1);
            transform: translateY(-5px);
        }

        .vote-btn.vote-draw {
            border-color: var(--text-secondary);
            color: var(--text-secondary);
        }

        .vote-btn.vote-draw:hover {
            box-shadow: 0 0 20px rgba(176, 181, 193, 0.4),
                        inset 0 0 20px rgba(176, 181, 193, 0.1);
            transform: translateY(-5px);
        }

        .vote-count {
            font-size: 1.5rem;
            font-weight: 900;
        }

        .vote-label {
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .vote-progress {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 3px;
            background: currentColor;
            animation: fillProgress 1s ease-out;
        }

        @keyframes fillProgress {
            from { width: 0 !important; }
        }

        .total-votes {
            text-align: center;
            color: var(--text-secondary);
            font-size: 0.95rem;
            font-weight: 600;
        }

        /* Comparison Section */
        .comparison-section {
            margin-bottom: 4rem;
        }

        .comparison-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
        }

        .comparison-item {
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.05), rgba(255, 0, 85, 0.05));
            border: 2px solid rgba(0, 212, 255, 0.2);
            border-radius: 15px;
            padding: 2rem;
            transition: all 0.3s ease;
        }

        .comparison-item:hover {
            border-color: rgba(0, 212, 255, 0.4);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.2);
        }

        .stat-bar {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .bar-label {
            font-weight: 600;
            letter-spacing: 1px;
            color: var(--text-secondary);
            font-size: 0.9rem;
        }

        .bar-container {
            display: flex;
            gap: 0;
            height: 25px;
            border-radius: 10px;
            overflow: hidden;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(0, 212, 255, 0.2);
        }

        .bar-fill {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.7rem;
            font-weight: 600;
            transition: all 0.5s ease;
        }

        .bar-fill.blue {
            background: linear-gradient(90deg, var(--primary-blue), rgba(0, 212, 255, 0.5));
            box-shadow: 0 0 10px rgba(0, 212, 255, 0.3);
        }

        .bar-fill.red {
            background: linear-gradient(90deg, var(--primary-red), rgba(255, 0, 85, 0.5));
            box-shadow: 0 0 10px rgba(255, 0, 85, 0.3);
        }

        .bar-values {
            display: flex;
            justify-content: space-between;
            font-size: 0.85rem;
            font-weight: 600;
        }

        .blue-text {
            color: var(--primary-blue);
        }

        .red-text {
            color: var(--primary-red);
        }

        /* Lineups Section */
        .lineups-section {
            padding: 5rem 0;
            background: linear-gradient(180deg, rgba(0, 212, 255, 0.05), rgba(255, 0, 85, 0.05));
        }

        .lineups-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 3rem;
            margin-bottom: 3rem;
        }

        .lineup-team {
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.08), rgba(255, 0, 85, 0.08));
            border: 2px solid rgba(0, 212, 255, 0.3);
            border-radius: 20px;
            padding: 2.5rem;
            transition: all 0.3s ease;
        }

        .lineup-team:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 40px rgba(0, 212, 255, 0.2);
        }

        .lineup-title {
            font-size: 1.3rem;
            font-weight: 900;
            margin-bottom: 2rem;
            letter-spacing: 1px;
        }

        .players-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
            gap: 1.5rem;
        }

        .player-card {
            background: linear-gradient(135deg, rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.1));
            border: 2px solid rgba(0, 212, 255, 0.2);
            border-radius: 12px;
            padding: 1.5rem;
            text-align: center;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .player-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: radial-gradient(circle at center, rgba(0, 212, 255, 0.1), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .player-card:hover {
            transform: translateY(-8px) scale(1.05);
            border-color: rgba(0, 212, 255, 0.5);
            box-shadow: 0 0 20px rgba(0, 212, 255, 0.3);
        }

        .player-card:hover::before {
            opacity: 1;
        }

        .player-number {
            display: inline-block;
            width: 50px;
            height: 50px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 900;
            margin: 0 auto 1rem;
            border: 2px solid;
            box-shadow: 0 0 15px currentColor;
        }

        .player-number.blue {
            background: rgba(0, 212, 255, 0.2);
            border-color: var(--primary-blue);
            color: var(--primary-blue);
        }

        .player-number.red {
            background: rgba(255, 0, 85, 0.2);
            border-color: var(--primary-red);
            color: var(--primary-red);
        }

        .player-name {
            font-weight: 700;
            font-size: 0.95rem;
            margin-bottom: 0.5rem;
        }

        .player-position {
            color: var(--text-secondary);
            font-size: 0.8rem;
            letter-spacing: 1px;
            margin-bottom: 0.8rem;
        }

        .player-stats {
            display: flex;
            justify-content: center;
        }

        .rating {
            font-size: 0.9rem;
            font-weight: 900;
            padding: 0.3rem 0.8rem;
            background: rgba(0, 212, 255, 0.1);
            border-radius: 5px;
            border: 1px solid rgba(0, 212, 255, 0.3);
        }

        /* Stats Section */
        .stats-section {
            padding: 5rem 0;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2.5rem;
        }

        .stats-card {
            background: linear-gradient(135deg, rgba(0, 212, 255, 0.08), rgba(255, 0, 85, 0.08));
            border: 2px solid rgba(0, 212, 255, 0.3);
            border-radius: 20px;
            padding: 2.5rem;
            transition: all 0.3s ease;
        }

        .stats-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 15px 40px rgba(0, 212, 255, 0.2);
            border-color: rgba(0, 212, 255, 0.5);
        }

        .stats-title {
            font-size: 1.3rem;
            font-weight: 900;
            margin-bottom: 2rem;
            color: var(--primary-blue);
            letter-spacing: 1px;
        }

        /* Scorers List */
        .scorers-list {
