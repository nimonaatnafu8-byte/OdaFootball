        }

        .history-score {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            flex: 0 0 auto;
        }

        .history-score-num {
            font-size: 1.8rem;
            font-weight: 900;
            min-width: 35px;
        }

        .history-score-vs {
            color: var(--text-secondary);
            font-size: 1rem;
            opacity: 0.5;
        }

        .match-status {
            display: inline-block;
            padding: 0.6rem 1.2rem;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 900;
