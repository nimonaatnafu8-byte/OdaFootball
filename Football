            }

            .team {
                padding: 1rem;
            }

            .team-stats {
                flex-direction: column;
                gap: 0.8rem;
            }

            .score-number {
                font-size: 2rem;
            }

            .voting-buttons {
                grid-template-columns: 1fr;
