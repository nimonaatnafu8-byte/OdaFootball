            color: var(--primary-blue);
            border: 1px solid rgba(0, 212, 255, 0.5);
        }

        .match-status.draw {
            background: rgba(176, 181, 193, 0.2);
            color: var(--text-secondary);
            border: 1px solid rgba(176, 181, 193, 0.5);
